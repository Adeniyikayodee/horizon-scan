# Copy to .streamlit/secrets.toml (local) or paste into the host's Secrets box.
# On Streamlit Community Cloud: app settings -> Secrets. Never commit the real file.

ANTHROPIC_API_KEY = "sk-ant-..."
APP_PASSWORD = "choose-a-team-password"

# Optional, only if the team should compare models via OpenRouter.
OPENROUTER_API_KEY = "sk-or-..."
