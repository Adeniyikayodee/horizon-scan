# Copy to .env and fill in. Only the key is required.
ANTHROPIC_API_KEY=

# Every stage runs on Opus 4.8 by default. Uncomment to downgrade individual
# tiers and save cost: Sonnet on the parallel legs, Haiku on the mechanical step.
# MODEL_OPUS=claude-opus-4-8
# MODEL_SONNET=claude-sonnet-5
# MODEL_HAIKU=claude-haiku-4-5-20251001
# MAX_CONCURRENCY=8
# WEB_MAX_USES=6

# To compare models, run the same agents on OpenRouter instead of Anthropic.
# SCAN_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OR_MODEL=openai/gpt-5          # e.g. google/gemini-2.5-pro, anthropic/claude-opus-4.1
